# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example

# Keys. Circle's own use-arc skill makes this a Security Rule: never hardcode,
# commit or log a private key, and never pass one as a plaintext CLI flag in a
# deployed environment (testnet included). Deployment uses an encrypted keystore
# under .keystore/, which must never leave this machine.
.keystore/
*.keystore
keystore/
*.key
password.txt

# Ledger backups written by the site's Backup button. These contain a real
# holdings history and must never be committed. Both prefixes: the download name
# changed with the rename, older backups keep the old one.
arcland-*.json
landbank-*.json

# Grant application working drafts. Contains personal contact details and a
# payout address; this repo is public, so it stays local.
grant/
