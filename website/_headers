# HTML must always revalidate: a cached index.html that predates a new script
# tag leaves the page running old markup against new JS, which fails in ways
# that look like a broken feature rather than a stale cache.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/tests.html
  Cache-Control: no-cache

# Fingerprint-free assets still revalidate; Pages already sends max-age=0.
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache

# ---------------------------------------------------------------- security
#
# This site has no backend, no accounts and no secrets, so the threat that
# actually matters is injected script: something that runs in the page and
# quietly ships a wallet address, a balance or a signature request somewhere.
# connect-src is therefore the load-bearing directive here — it is an allowlist
# of every origin this code is permitted to talk to, and nothing else can be
# reached even if an injection succeeds.
#
# script-src is a strict allowlist too. The one inline script is the <head>
# theme boot, which exists so the page never flashes the wrong theme before
# first paint; it is pinned by hash rather than waved through with
# 'unsafe-inline'. IF THAT SCRIPT IS EDITED, THE HASH MUST BE RECOMPUTED:
#   python3 -c "import re,hashlib,base64,pathlib; \
#     b=re.findall(r'<script>(.*?)</script>', pathlib.Path('index.html').read_text(), re.S)[0]; \
#     print('sha256-'+base64.b64encode(hashlib.sha256(b.encode()).digest()).decode())"
# A stale hash means the theme boot is blocked and the page loads in the wrong
# theme — visible, but easy to misread as a CSS bug.
#
# There are no per-page exceptions: tests.html loads its runner from tests.js
# rather than inline, precisely so one strict policy can cover every page. An
# inline runner would have needed either 'unsafe-inline' or a hash recomputed on
# every assertion added — and multiple CSP headers INTERSECT, so a looser
# per-path rule cannot override this one anyway.
#
# style-src carries 'unsafe-inline', and that is a deliberate, narrower
# compromise rather than an oversight. The whale list colours each swatch by
# hue and by rank (iso.js whaleColor), which is a per-row computed value that
# cannot be enumerated as a class or hashed. Inline *style* injection is a far
# weaker vector than inline script — with script-src strict and connect-src
# closed, there is nowhere for CSS-based exfiltration to send anything.
#
# img-src allows data: because wallet icons arrive as data: URIs over EIP-6963
# (already validated as data: in arc.js, which refuses remote icon URLs), and
# the favicon is an inline SVG data URI.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-JaVZ0WT65MSppYZijq0xB8N4mUtPMN0fNDrgkL/RRIc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rpc.testnet.arc.io https://rpc.blockdaemon.testnet.arc.io https://rpc.drpc.testnet.arc.io https://rpc.quicknode.testnet.arc.io https://api.circle.com https://api.coingecko.com https://www.okx.ac; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
